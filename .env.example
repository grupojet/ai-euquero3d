# ═══════════════════════════════════════════
# EUQUERO3D AI PLATFORM — Environment Config
# ═══════════════════════════════════════════

# Database
DB_PASSWORD=e3d_secure_2026_change_me

# MinIO (S3-compatible storage)
MINIO_USER=euquero3d
MINIO_PASS=e3d_minio_2026_change_me

# App Security
SECRET_KEY=change_this_to_a_random_64_char_string

# GPU Worker
# Se tiver múltiplas GPUs, ajuste CUDA_VISIBLE_DEVICES
CUDA_VISIBLE_DEVICES=0

# Modelos a carregar (hunyuan3d, triposr, ou ambos)
ACTIVE_MODELS=hunyuan3d,triposr

# Opcional: HuggingFace Token (para download de modelos que precisam auth)
# HUGGINGFACE_TOKEN=hf_xxxxxxxx
